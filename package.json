{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently  \"yarn dev:board\" \"yarn dev:salty\"",
    "dev:salty": "yarn workspace salty-lens dev",
    "dev:board": "yarn workspace surf-garage dev",
    "build:salty": "yarn workspace salty-lens build",
    "build:board": "yarn workspace surf-garage build",
    "deploy:salty": "sh deployRsyncArt.sh",
    "deploy:board": "sh deployRsyncBoard.sh",
    "deploy": "sh deployRsync.sh",
    "restart": "sh restart.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
